QWidget{
    background-color: beige;
}

QPushButton{
    border: 1px solid black;
    background-color: white;
    border-radius: 10px;
    padding: 5px;
    
}

QPushButton#pushButton{
    border: 3px solid rgb(231, 19, 19);
    background-color: white;
    color: red;
    
}

QPushButton#pushButton_2{
    border: 3px solid rgb(30, 184, 16);
    background-color: white;
    color: green;
}

QLabel{
   color: blue;
   font-weight: bold;
}

QLineEdit{
    border: 1px solid blue;
    border-radius: 3px;
    background-color: white;
    color: black;
}
