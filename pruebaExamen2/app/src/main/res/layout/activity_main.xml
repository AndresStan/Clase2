<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangulochill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/SaludoPrograma"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="29sp"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold"
            tools:text="Bienvenido al programa %USER" />
    </androidx.gridlayout.widget.GridLayout>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="2"
        android:padding="50dp"
        app:alignmentMode="alignMargins"
        app:layout_gravity="center"
        app:useDefaultMargins="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout2">


        <com.google.android.material.card.MaterialCardView

            app:cardBackgroundColor="@color/error"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/black"

            app:layout_columnWeight="1"
            app:strokeWidth="5dp">



            <ImageView
                android:id="@+id/imagencard0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView

            app:cardBackgroundColor="@color/error"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/black"

            app:layout_columnWeight="1"
            app:strokeWidth="5dp">



            <ImageView
                android:id="@+id/imagencard1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView

            app:cardBackgroundColor="@color/error"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/black"

            app:layout_columnWeight="1"
            app:strokeWidth="5dp">



            <ImageView
                android:id="@+id/imagencard2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView

            app:cardBackgroundColor="@color/error"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/black"
            app:layout_columnWeight="1"

            app:strokeWidth="5dp">



            <ImageView
                android:id="@+id/imagencard3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>



    </androidx.gridlayout.widget.GridLayout>

    <TextView
        android:id="@+id/textoPro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="ELIJE UNA CAJA RANDOM SORPRESA TACHAN"
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="409dp"
        android:padding="40dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/textoPro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tellevas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="¿Te quieres llevar algo?" />
    </com.google.android.material.textfield.TextInputLayout>


</androidx.constraintlayout.widget.ConstraintLayout>